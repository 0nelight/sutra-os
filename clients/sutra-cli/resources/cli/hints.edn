
{:verbs
 {:guide       {:theme :orient
                :purpose "List every CLI verb grouped by purpose — the discovery entry point."
                :when "First contact, or when you've forgotten what verbs exist. Then `explain <verb>` for depth."}
  :explain     {:theme :orient
                :purpose "Show the full curated hint for one verb or modeling concept."
                :when "Before authoring with an unfamiliar verb, or before modeling (`explain primary-key`, `explain interface`)."
                :patterns
                ["Read a verb's hint for its exact OUTPUT FIELDS and its COST before you script against it, not just for what it does — a verb like `preview-transform` RUNS the transform (model calls included), so batching several blindly into one process is how a call ends up timing out."]
                :anti-patterns
                [{:rule "Don't screen-scrape CLI JSON through a parser that GUESSES which field holds the datum."
                  :why "`d.get('count') or d.get('row-count') or len(d.get('rows',[]))` is fuzzy-matching, and it is silently wrong when the real key differs from every guess (it prints `count: None` rather than failing). `explain <verb>` documents the exact keys — read the ONE known path. If no verb surfaces the datum at all, that is a CLI gap to fill, not something to reverse-engineer at the shell."}]
                :examples ["explain create" "explain primary-key" "explain action"]}
  :context     {:theme :orient
                :purpose "Server-backed 'where am I': current branch, staged-batch summary, identity, object/link counts, integrity."
                :when "At the start of a fresh turn (your window may have been summarized) to re-sync from the server — the source of truth — instead of guessing."
                :patterns
                ["Pull, don't hold: the server owns the staged batch; the branch is the request's (`--branch`, or `checkout` inside this session), main when none is named. Re-read `context` rather than tracking it in your head."]
                :examples ["context" "context --json"]}
  :explore     {:theme :inspect
                :purpose "Free-text object search; seeds the selection register (#1/$ in the REPL)."
                :when "You know a name/word but not an id. As an LLM prefer `--json` and carry the real ids forward."
                :see-also [:around :query]}
  :around      {:theme :inspect
                :purpose "1-hop neighbourhood of the selected object(s) — 'expand neighbourhood'."
                :when "To see what an object links to. Composes after `explore`/`query`."
                :see-also [:explore :links]}
  :links       {:theme :inspect
                :purpose "List link instances, optionally scoped by --type / anchored at --from."
                :see-also [:action :link-type]}
  :dependents  {:theme :inspect
                :purpose "Impact-before-change: everything in the live schema that references one object-type — the links touching it, the transforms that read/write it, and the apps bound to it."
                :when "BEFORE a breaking edit (rename/drop a property, delete a type): see what would break. The reverse of `describe`, which shows a type's own shape; this shows what depends ON it."
                :anti-patterns
                [{:rule "Don't stitch a reader list from `describe`, `links` and `lineage` by hand."
                  :why "Each sees one kind of reader. The answer's `:readers` is the one reverse index the server keeps (the same edges as `lineage facts`), grouped by the reader's kind — apps by every object set their layout reads, functions, eval suites, automations and exports included. A RID or kind/name works as the handle."}]
                :see-also [:describe :links :around :lineage]}
  :lineage     {:theme :inspect
                :purpose "Read-only Data-Lineage over the live schema: bare `lineage` prints the whole transform DAG (inputs → transform → output); `lineage <node>` shows ONE node's immediate up/downstream (which transforms produce it, which consume it)."
                :when "To trace how a dataset/object-type/link-type is built and what a change would ripple into — the pipeline-wide view `dependents` gives for a single object-type. Derived purely from the schema; no build needed."
                :anti-patterns
                [{:rule "Don't read a transform's output as `(:output t)` — go through `outputs-of` (server) / `transform-outputs` (CLI)."
                  :why "`:output` is SUGAR for a one-element `:outputs`. A transform authored with the plural (python `@transform(outputs={…})`, EDN `:outputs [{…}]`) carries NO `:output` key, so a direct read returns nil on exactly the nodes that land several datasets — typically the ingest roots. The failure is not an empty answer but a PLAUSIBLE WRONG one: measured on prod with one multi-output transform out of 113, `lineage` dropped the edge and reported `produced-by []` for a real dataset, `transform show` said `output {}`, `describe <type>` claimed the type had no primary key (the PK lives on the MATCHING output entry), and `schedule candidates` concluded 'no producer ⇒ use a cadence'. When resolving 'who produces node X', return the `[transform output]` PAIR, never the transform alone."}]
                :examples ["lineage" "lineage bestellung"]
                :see-also [:dependents :describe :consumption :delta]}
  :lineage-facts
  {:theme :pipeline
   :purpose "Data lineage as text: one line per edge (`input ─[transform]→ output`, and every other reader as `d:x ─backs→ o:y`, `o:y ─edits→ act:z`, `o:y ─shows→ app:a`, functions, eval suites, automations, exports); per node its indicators — build status, freshness, rows, data health, open issues, schedules (paused counted apart), syncs, the object types a dataset defines / the dataset backing a type, trashed — and per transform a status word. --detail all (or a comma list) adds every node field (resource overview, repository, compute, transaction type, storage, last write, duration, model usage) and per transform where it is declared, what starts it, last run / success / failure, the model it really calls (:declared-not-called names a declared provider no model input calls) and its readers. Anchor on a name, kind/name or RID of any kind (comma list), --column C (Find by column: every dataset/object type carrying it), --project P, --graph G; --up/--down N (or all). Analyses: --out-of-date (the out-of-date colouring: `parent` = an input changed after the last success, `logic` = the code is not the code that success ran, `ancestor` = only something upstream is, `never-built`; with the changed inputs / the stale ancestors), --by F[,F] (the selection histogram / node colourings: kind, project, build-status, freshness, health, repository, resource, compute, write-mode, storage, schedules, issues, last-built, defines, syncs), --schedules (Manage schedules: when to build, targets, scope, paused, latest run), --dead (outputs no DECLARED reader reaches — a list to review, not the linter's observed `unused`, never a reason to delete on its own), --stale 7d (inputs changed after a last success older than that), --blocked (what cannot be deleted and why, incl. `in no text`), --diff-live (a saved graph against the live one). Server-side (:lineage-facts); the canvas colours and its properties panel read the same node facts (:lineage-status)."
   :when "To answer a pipeline question in one call — when did it run, what starts it, who still reads its output, what can go — instead of looping `transactions`/`consumption`/`transform show` per transform."
   :anti-patterns
   [{:rule "Don't date a transform by its output's transactions."
     :why "A link dataset or a supplement on an object type has no transaction of its own; the run is the transform's JOB in the ledger, which this verb reads for every transform alike."}
    {:rule "Don't decide what is dead from transform inputs alone."
     :why "Object types backed by a dataset, links, apps, actions, functions, eval suites, automations and exports read outputs too; `--dead` counts all of them, a hand filter over `lineage` does not."}]
   :examples ["lineage facts" "lineage facts bestellung --up 2 --down 1"
              "lineage facts --project beschaffung --dead"
              "lineage facts --stale 7d" "lineage facts journal-raw --blocked"
              "lineage facts --graph rechnungen --diff-live"
              "lineage facts aggregate-orders --detail all --json"
              "lineage facts bestellung --up all --out-of-date"
              "lineage facts --project beschaffung --by freshness,build-status"
              "lineage facts --column kostenstelle"
              "lineage facts journal-raw --schedules"]
   :see-also [:lineage :runs :jobs :dependents :graph-show]}
  :graph-list  {:theme :inspect
                :purpose "The saved lineage graphs on this branch: title, slugged name, mode, kompass path and the branch config saved with each one."
                :when "To find a saved drawing before opening it."
                :examples ["lineage-graph list" "lineage-graph list --mode lineage"
                           "lineage-graph list --project ersatzteile"]
                :see-also [:graph-show :lineage :project-files]}
  :graph-show  {:theme :inspect
                :purpose "One saved graph in full: its title, RID, kompass path, owning project, the branch + fallback branches saved WITH it, the node scope it draws, and how many layout rows / colour schemes it carries."
                :when "To open a graph you have any handle for. the slugged name, the RID, or the kompass path."
                :patterns ["Quote a path handle: `lineage-graph show '/lineage/Wareneingang'`."
                           "A pasted free-text title works too — it is slugged to the same name."]
                :examples ["lineage-graph show ersatzteile-wareneingang"
                           "lineage-graph show ri.sutra.main.graph.0f77286a-a09d-4087-a9bf-50ca010c6ff7"
                           "lineage-graph show /lineage/Wareneingang"]
                :see-also [:graph-list :graph-scope :lineage]}
  :custom-app-show {:theme :inspect
                    :purpose "One custom application in full: its scope, its clients, its hosting and its metrics."
                    :when "Before minting a credential, or when a call from an external app was refused and you need to see what it is allowed to touch."
                    :examples ["custom-app show angebots-editor"]
                    :see-also [:custom-app :custom-app-sdk]}
  :custom-app-sdk {:theme :inspect
                   :purpose "The application's SDK, generated from its SCOPE alone — the same generator as `sdk generate`, over a schema narrowed to what the declaration lists."
                   :when "To hand an external team a typed client that cannot even name what they may not reach."
                   :patterns
                   ["A link whose far end is out of scope is dropped too: a traversal that would always be refused is worse than a missing one."
                    "The module stamps a fingerprint over the NARROWED schema, so adding an unrelated type elsewhere does not force a regeneration."]
                   :examples ["custom-app sdk angebots-editor --out angebote-sdk/src"]
                   :see-also [:custom-app-docs :sdk-verify]}
  :custom-app-docs {:theme :inspect
                    :purpose "SDK reference documentation for the application, rendered from the same narrowed schema the SDK is generated from."
                    :when "To ship documentation with the SDK that cannot describe a type the SDK does not carry."
                    :examples ["custom-app docs angebots-editor --out ANGEBOTE_SDK.md"]
                    :see-also [:custom-app-sdk]}
  :custom-app-metrics {:theme :inspect
                       :purpose "Calls, errors and latency for one custom application, per API namespace and day."
                       :when "To see whether an external application is actually used, and where it fails."
                       :patterns
                       ["Recorded only when the declaration carries `:metrics true` — counting is a decision, not a default."]
                       :examples ["custom-app metrics angebots-editor"]
                       :see-also [:custom-app-show]}
  :custom-app-client-mint {:theme :change
                           :purpose "Mint an authorization client for a declared custom application. The secret is returned ONCE."
                           :when "When an external application needs to authenticate — a service (client_credentials) or on behalf of a person (authorization_code)."
                           :patterns
                           ["`client_credentials` runs as the client's OWN service user, created with it and named like its client id. It starts with no access: grant it roles with `access grant <project> --role <role> --to <client-id>`. There is no `--service-user` — a client never runs as a principal of your choosing, so its writes are always the client's."
                            "A lost secret is ROTATED, never recovered — only its hash is stored."]
                           :examples
                           ["custom-app client mint angebots-editor --grants client-credentials"
                            "custom-app client mint angebots-editor --grants authorization-code --redirect https://angebote.example/cb"]
                           :see-also [:custom-app-client-rotate :custom-app-client-revoke]}
  :custom-app-client-rotate {:theme :change
                             :purpose "Issue a new secret for an existing client, keeping its id."
                             :when "After a leak, or on a rotation schedule."
                             :examples ["custom-app client rotate angebots-editor cid-1234"]
                             :see-also [:custom-app-client-mint]}
  :custom-app-client-revoke {:theme :change
                             :purpose "Revoke a client credential. Tokens already minted keep their remaining lifetime — set a short `:token-ttl` on the declaration if that matters."
                             :when "When an application is retired or a credential is compromised."
                             :examples ["custom-app client revoke angebots-editor cid-1234"]
                             :see-also [:custom-app-client-rotate]}
  :sdk-generate {:theme :inspect
                 :purpose "Generate an client SDK. It contains no data and no ontology definition, so every call it makes still reads live."
                 :when "To drive the ontology from code with the names checked at compile time instead of spelled as strings — a script, a test, another service."
                 :patterns
                 ["The module stamps the ontology's FINGERPRINT. That is the only drift an SDK can suffer that data cannot: the type level freezes at generation, the rows never do."
                  "Additive ontology changes are harmless — the old module simply does not know the new property. Renames and deletions are what the fingerprint catches."
                  "The Python Platform SDK (`sutra-platform-sdk generate`) computes the SAME fingerprint from the same ontology, so both generators make one statement about drift, not two."
                  "One namespace per KIND, so an object type and an action of the same name cannot silently overwrite each other; actions and edit functions carry a `!`."
                  "`--package` adds deps.edn + sdk.edn, so a separate app depends on the SDK instead of copying a file into its tree."]
                 :examples ["sdk generate ersatzteile.sdk --out ./ersatzteile-sdk --package"
                            "sdk generate my.sdk --out ./my-sdk --package --runtime-git <url> --runtime-sha <sha>"
                            "sdk generate my.sdk"]
                 :see-also [:sdk-verify :sdk-fingerprint :describe]}
  :sdk-verify  {:theme :inspect
                :purpose "Compare a generated module's stamped fingerprint against the live ontology — the check that turns 'the script broke in production' into one explicit answer."
                :when "In CI, before a deploy, or whenever a generated SDK has been sitting in a repo while the ontology moved."
                :patterns
                ["Exit 1 on drift, so it wires into a pipeline without parsing the output."]
                :examples ["sdk verify ./ersatzteile-sdk"
                           "sdk verify ersatzteile-sdk/src/ersatzteile/sdk.clj"]
                :see-also [:sdk-generate :sdk-fingerprint]}
  :sdk-fingerprint {:theme :inspect
                    :purpose "The live ontology's SDK fingerprint: 16 hex digits over every API name, property, link and action parameter list."
                    :when "To tell two ontologies apart at the TYPE level, or to check a pinned SDK by hand."
                    :patterns
                    ["Ignores rows entirely — two instances with the same schema and different data fingerprint identically."]
                    :examples ["sdk fingerprint"]
                    :see-also [:sdk-generate :sdk-verify]}
  :widget-sets {:theme :project
                :purpose "List the widget sets: versioned ClojureScript that App Studio shows in a sandboxed frame through a :custom-widget."
                :when "To see which widget sets exist and their newest version."
                :examples ["widget-set"]
                :see-also [:widget-set-show :widget-set-create :custom-app]}
  :widget-set-show {:theme :project
                    :purpose "One widget set: its project, versions, and what each version's widgets declare."
                    :when "Before binding a :custom-widget, to read the parameters and events of a version."
                    :examples ["widget-set show zaehler"]
                    :see-also [:widget-sets :widget-set-publish]}
  :widget-set-create {:theme :project
                      :purpose "Create an empty widget set in a project. Its permissions are the project's."
                      :when "Once, before the first publish."
                      :examples ["widget-set create zaehler --project einkauf"]
                      :see-also [:widget-set-init :widget-set-publish]}
  :widget-set-init {:theme :project
                    :purpose "Write a working starter into a directory: widgets.edn and one .cljs. A widget is ClojureScript with Reagent; `sutra.widget` is its way to the app."
                    :when "To start a new widget set."
                    :examples ["widget-set init /home/me/zaehler"]
                    :see-also [:widget-set-publish :widget-set-dev]}
  :widget-set-publish {:theme :project
                       :purpose "Release a directory's text files as version x.y.z. There is no build. The server refuses a release whose manifest or source does not read, and a version once published never changes."
                       :when "When a state of the code is meant for others. A usage without a pinned :version shows it at once; a pinned one stays where it is."
                       :examples ["widget-set publish zaehler /home/me/zaehler --version 1.0.0"]
                       :see-also [:widget-set-dev :widget-set-pull]}
  :widget-set-dev {:theme :project
                   :purpose "Dev mode: wherever the set is used, YOU see the directory instead of the release, and each save reloads the frame. Runs until interrupted; the draft stays until --stop."
                   :when "While developing, inside the real app with its real data."
                   :examples ["widget-set dev zaehler /home/me/zaehler" "widget-set dev zaehler --stop"]
                   :see-also [:widget-set-publish]}
  :widget-set-pull {:theme :project
                    :purpose "Write a release's source into a directory, the newest unless --version names one."
                    :when "To continue from what is published, or to read what a version really is."
                    :examples ["widget-set pull zaehler /home/me/zaehler --version 1.0.0"]
                    :see-also [:widget-set-publish]}
  :widget-set-delete {:theme :project
                      :purpose "Delete a widget set with all its versions. Apps that show it report that instead."
                      :when "When nothing uses it any more."
                      :examples ["widget-set delete zaehler"]
                      :see-also [:widget-sets]}
  :custom-app {:theme :inspect
               :purpose "The Developer Apps read: custom applications — code that runs OUTSIDE the platform and reaches the ontology through an OAuth client and a generated SDK. Bare lists them."
               :when "To see which applications hold a token and whether what they name still exists — an object type in :scope, the project or repository, the redirect URIs, and whether the hosted callback URL is actually a redirect URI."
               :patterns
               ["It writes nothing. Schema ships through `projection push`, so `--declaration` prints the `:custom-applications` block to paste into the pulled text — that block is the output, not a debug view."
                "The same read the browser pane at /developer-apps makes, so the terminal answers it without a browser."
                "An empty list is reported two ways on purpose: `no custom applications declared` (the section exists, nothing in it) versus `the :custom-applications section is not installed on this instance`."]
               :anti-patterns
               [{:rule "Do not confuse it with `apps` — that lists App Studio apps, which run INSIDE the platform and have no OAuth client."
                 :why "The two are different planes: App Studio is the Interagieren surface, the Developer Apps is for code you host yourself."}]
               :examples ["custom-app" "custom-app portal" "custom-app portal --declaration"]
               :see-also [:sdk-generate :apps]}
  :graph-svg   {:theme :inspect
                :purpose "Draw one saved graph as a standalone .svg — the server renders it from the graph's own scope and stored layout, so a picture of a pipeline needs no browser and no screenshot."
                :when "To embed a lineage picture in a report, a review, or a ticket — or to see a graph at all from a terminal."
                :patterns
                ["Without `--out` the SVG goes to stdout; with it, the file is written and the path printed."
                 "Nodes nobody has ever dragged have no stored position — those are laid out left→right beside the placed ones, so a graph saved by the CLI still draws as a readable DAG."]
                :examples ["lineage-graph svg ersatzteile-wareneingang --out wareneingang.svg"
                           "lineage-graph svg /lineage/Wareneingang > graph.svg"]
                :see-also [:graph-show :graph-scope :lineage]}
  :graph-dot   {:theme :inspect
                :purpose "The same drawing as Graphviz DOT source — nodes, edges, kind colours and the saved positions as pinned points."
                :when "When the picture is an INPUT rather than something to look at: piping into Graphviz, re-laying it out, or diffing two branches' graphs as text."
                :patterns
                ["`neato -n` honours the pinned `pos=\"x,y!\"` points, so it reproduces what `lineage-graph svg` shows; plain `dot` re-layers it left→right."
                 "Without `--out` the DOT goes to stdout, so it pipes: `lineage-graph dot g | dot -Tpng -o g.png`."]
                :examples ["lineage-graph dot ersatzteile-wareneingang --out wareneingang.dot"
                           "lineage-graph dot ersatzteile-wareneingang | dot -Tpng -o graph.png"]
                :see-also [:graph-svg :graph-show :lineage]}
  :graph-create {:theme :author
                 :purpose "Save a NEW graph: a free-text title, an optional folder to file it in, an owning project, the branch config to store with it, and the nodes it draws."
                 :when "To capture a drawing as a shareable, re-openable resource instead of a throwaway view."
                 :patterns
                 ["`--into <folder>` is what gives the graph a PATH; without it the graph is saved but unfiled."
                  "`--node <kind>/<name>` may repeat; a bare name means an object-type. Kinds: datasource, dataset, transform, object-type, link-type."
                  "SEED, then EXPAND — don't type the closure by hand: `--ancestors N` / `--descendants N` walk N transform hops out from the seed nodes. One `lineage` read serves any depth."]
                 :examples
                 ["lineage-graph create \"Ersatzteile · Wareneingang\" --into lineage --node object-type/bestellung --node transform/aggregate-orders"
                  "lineage-graph create \"Rechnungslauf\" --project ersatzteile --node object-type/rechnung --ancestors all"
                  "lineage-graph create \"Kalkulation\" --mode lineage --project werft --branch main"]
                 :see-also [:graph-save-as :graph-scope :graph-move :place]}
  :graph-save-as {:theme :author
                  :purpose "Copy a saved graph under a new title (and optionally into a new folder). The copy gets its own RID and diverges from here."
                  :when "To fork a drawing for a variant audience without disturbing the original."
                  :patterns
                  ["Node POSITIONS are per-graph working data and are NOT copied; the scope, branch config and zoom are."]
                  :examples
                  ["lineage-graph save-as ersatzteile-wareneingang \"Wareneingang (Audit)\" --into audit"]
                  :see-also [:graph-create :graph-move]}
  :graph-rename {:theme :author
                 :purpose "Retitle a saved graph. The RID is unchanged and the kompass placement points at the RID, so the graph keeps its location and every reference to it."
                 :when "The drawing outgrew its working title."
                 :examples ["lineage-graph rename draft-graph \"Arbeitspaket-Tracking\""]
                 :see-also [:graph-show :rename]}
  :graph-move  {:theme :author
                :purpose "Relocate a saved graph in the Kompass tree — this is what changes its PATH. Pure filesystem write: no stage/commit, because a location is a placement, not schema state."
                :when "To file a graph into the project folder its audience browses."
                :patterns
                ["No `--into` moves it to the root. The target folder is created if it doesn't exist."]
                :examples ["lineage-graph move ersatzteile-wareneingang --into lineage"]
                :see-also [:place :project-files :graph-show]}
  :graph-scope {:theme :author
                :purpose "Edit which nodes the graph draws. `:visible-types` has INCLUSION semantics, so this is a set edit."
                :when "To grow or prune a saved drawing without redrawing it."
                :patterns
                ["`--add`/`--remove` take `<kind>/<name>` and may repeat; a bare name means an object-type."
                 "An empty scope means \"every node\", not \"no nodes\"."]
                :examples
                ["lineage-graph scope ersatzteile-wareneingang --add object-type/wareneingang --add link-type/eingang-bestellung"
                 "lineage-graph scope ersatzteile-wareneingang --remove transform/aggregate-orders"]
                :see-also [:graph-show :lineage :dependents]}
  :graph-branch {:theme :author
                 :purpose "Set the BRANCH configuration saved with the graph: the branch it opens on, plus the ordered fallback list consulted when a node doesn't exist on that branch."
                 :when "this is that field."
                 :examples
                 ["lineage-graph branch ersatzteile-wareneingang --branch feature/kalk --fallback main"]
                 :see-also [:graph-show :branches :checkout]}
  :graph-arrange {:theme :author
                  :purpose "Set the layout a graph opens in: the canvas lays out every node without a saved position as Shift+L (hier-lr) or another whole-graph layout would. `none` returns to the default."
                  :when "a saved graph must open laid out the same way every time — an embed, a screenshot, a fresh instance — without anyone pressing a layout key."
                  :examples
                  ["lineage-graph arrange farm-lineage hier-lr"]
                  :see-also [:graph-show :graph-svg]}
  :graph-delete {:theme :author
                 :purpose "Delete a saved graph. Its layout rows, colour schemes and Kompass placement are swept with it, so no ghost entry is left in the file tree."
                 :when
                 "The drawing is obsolete. Reversible like any schema change — via the branch."
                 :examples ["lineage-graph delete throwaway"]
                 :see-also [:graph-list :trash]}
  :series      {:theme :inspect
                :purpose "Read a TIME SERIES PROPERTY's values over an object set — timestamp/value pairs out of the property's sync dataset, optionally bucketed and folded."
                :when "For a measurement over time that is MATERIALIZED (`describe <type>` shows the property as `:timeseries`). For a number per period folded out of EVENT rows at read time, that is an aggregation instead — over HTTP `POST /api/ontology/query` with `:aggs`/`:group-by`. Either way: never a `<thing>-per-month` object type."
                :patterns
                ["`--property` is required — it names the `:timeseries` property, and the SYNC follows from it (you never name a dataset)."
                 "`--bucket week|month|…` folds points per period; `--rollup sum|avg|min|max|count` says HOW. If the property declares a `:rollup`, the flag is optional — and a bucketed read with neither is REFUSED, not guessed."
                 "The window is HALF-OPEN: `--from` is inclusive, `--until` is EXCLUSIVE. That is why it is not `--to` — an inclusive upper bound silently drops the last day of a timestamped series."
                 "`--where` is the same clause vocabulary `query` uses, and it scopes the OBJECTS: the series you get back are the ones your objects carry. A filter that matches nothing answers with no series, never with the whole sync."
                 "Bucket labels are strings (`2026-W32`, ISO weeks) — chronologically sortable as text, and identical to the labels an aggregation gives the same day."]
                :anti-patterns
                [{:rule "Don't add a `<thing>-per-week/-month` object type to get a number per period."
                  :why "A cube cell is not an entity — and its primary key is derived from the grain, so every grain change is an identity migration that leaves rows nothing retracts."}
                 {:rule "Don't sum a LEVEL series (a balance) or average a FLOW series (hours booked) just because the flag accepts it."
                  :why "Both produce a plausible chart line that means nothing. Declare the right `:rollup` on the property once, where the knowledge lives."}]
                :see-also [:query :describe]}
  :query       {:theme :inspect
                :purpose "List / filter / count objects of a type with chosen columns — the precise-slice reader."
                :when "The token-cheap way to inspect data: pick exactly the columns and rows you need instead of dumping whole objects."
                :patterns
                ["Always `--show a,b,c` to project only the columns you need — whole objects (esp. body text) are 15-20× larger. (`--columns`/`--cols` alias `--show`.)"
                 "A bare `query <type>` doubles as a snapshot COUNT."
                 "`--where` ops: `=` `!=` `<` `>` `<=` `>=` `^=`(starts-with) `~`(contains). Comma-separates ANDed clauses; quote a value with spaces (`--where 'art-bezeichnung=Keine Zeitbuchung'`). Text ops run server-side as SQL LIKE and match wildcards literally — `~%` finds a percent sign, not everything."
                 "`--offset` pages: `--limit 50 --offset 50` is rows 51-100. It needs `--limit` (a start with no size is still a full read, and is rejected). Pages can't repeat or drop a row even when `--order` is a non-unique column — the backend breaks ties on the primary key."
                 "`--order <col>` sorts ASCENDING; add a direction with `--order <col>:desc` (also `<col>:asc`). For \"the last N\" combine `--order <ts>:desc --limit N` — don't fetch everything and sort client-side."
                 "`--json` payload shape is `{\"rows\":[{\"id\":…, \"values\":{<col>:<val>}}], \"count\":<pre-limit N>}` — the projected columns live under each row's `values`, NOT at the row top level."
                 "Filter on a LINKED object with `side.attr=val` — e.g. `--where arbeitspaket-arbeitsauftrag.wo-art-id=8` finds objects whose linked WO is art 8. This is how you express a join-filter without fetching everything."
                 "A link is addressed by its SIDE: every link type has two, each with its own API name as seen from its near type (`:forward-api-name` from `:from`, `:reverse-api-name` from `:to`; both default to the link-type name). `--around`, `--where side.attr` and `--show side.attr` all take that name. There is NO direction flag — the side carries the direction, and a self-link has two sides with two different names."
                 "Follow links with `--around side1,side2` — the far side of each hop BECOMES the set. `--show attr,side.attr` instead keeps the rows and adds a column of the linked objects' attrs."]
                :anti-patterns [{:rule "Don't fetch whole objects when you need three fields."
                                 :why "Floods your context with body-text/large scalars for no benefit."}
                                {:rule "Don't pull a whole type and filter client-side to find rows linked to a matching object."
                                 :why "The engine does connection-filters server-side: `--where <side>.<attr><op><val>`."}]
                :examples
                ["query email --show absender,betreff --where status=neu --limit 20 --json"
                 "query email --show von-adresse,betreff,gesendet-am --order gesendet-am:desc --limit 10   ; the last 10, newest first"
                 "query arbeitsauftrag --show wo-nr,art-bezeichnung --where projekt-id=2774 --where wo-art-id>=9"
                 "query arbeitspaket --show paket-code --where arbeitspaket-arbeitsauftrag.wo-art-id=8"
                 "query arbeitspaket --show paket-code,arbeitspaket-arbeitsauftrag.wo-nr   ; a one-hop column along that side"
                 "query arbeitspaket --where paket-code=P1 --around arbeitspaket-arbeitsauftrag   ; the linked WOs become the set"
                 "query bestellung --where status=offen --save   ; mint a 24h handle, then: query --object-set <rid>"]
                :see-also [:describe :explore :object-sets]}
  :object-sets {:theme :inspect
                :purpose "List every object set the session can see — saved (permanent, project-owned, from .ent) and temporary (creator-only, 24h handles) — and drop a temporary handle early."
                :when "After `query … --save` to see your live handles; before wiring an action's `:options-from` to check which saved sets exist."
                :patterns
                ["Mint handles with `query <type> … --save` (add `--freeze` to materialize: the member list is stored and stays frozen against later data; without it the definition re-evaluates)."
                 "Read a set back — and compose on top of it — with `query --object-set <name|rid> [--where …] [--around …]`; a saved set's name and any set's rid both resolve."
                 "`--delete <rid>` drops a temporary handle early; deletion is creator-scoped, so a not-yours/expired/unknown rid all answer the same."]
                :examples ["object-sets"
                           "query bestellung --where status=offen --save --freeze"
                           "query --object-set ri.sutra.main.temporary-object-set.<uuid> --limit 10"
                           "object-sets --delete ri.sutra.main.temporary-object-set.<uuid>"]
                :see-also [:query]}
  :describe    {:theme :inspect
                :purpose "Show the live schema as section→names, or the shape (fields/links/implements + live count) of one OR SEVERAL object-types/sections named in one call."
                :when "Before editing a type: `describe <object-type>` tells you what it looks like RIGHT NOW. A bare `describe` gives the section overview. Name several types at once instead of looping the verb."
                :patterns
                ["`describe` (no arg) = counts+names per section, never the full schema map — safe for context."
                 "`describe a b c` = variadic: each type/section rendered in turn — NEVER shell-loop `describe` over a list."
                 "An object-type shows its `pk` (deterministic primary key) and a link-type shows its `backing` (fk / join-table / resolve-by-shared-property / polymorphic + the producing transform) — both read off the producing transform, not the type spec. So you NEVER need to scrape the raw schema via sutra.wire.api to learn a PK or how a link is fed: describe surfaces it. (A datum describe still can't show = a CLI gap to FILL, not a reason to hand-roll sutra.wire.api/current-schema.)"]
                :examples ["describe" "describe object-types" "describe email"
                           "describe bestellung arbeitspaket email"]
                :see-also [:query :diff-schema]}
  :diff-schema {:theme :inspect
                :purpose "Preview what installing the named file(s) WOULD change against the live schema — non-mutating (stages, renders the real reconcile, discards). Variadic and dispatched by extension: .ent (schema grammar), .enta (standalone app), .entv (object views); each file's sibling .enta/.entv and its :code-file/:source-file/:template-file are folded in, so what is judged is the LOCAL candidate set, not the server's copy of the tree."
                :when "Before the push — this is the pre-push validator: the grammar rejects a bad key with an indexed path, and the live schema catches what no offline check can (python introspection, a second producer for one type, a predicate over a property that does not exist)."
                :patterns
                ["Paths resolve from the checkout you are STANDING in (SUTRA_CALLER_PWD), not the repo root `bin/sutra` cd's to — so a path inside your own clone works. Root-relative wins when it also resolves, which keeps runbooks intact."
                 "Non-mutating in its RESULT, not in its mechanism: it STAGES the reconcile on the target, renders the tally, then clears the staging. If someone else's batch is already staged it refuses up front (`⏸ N change(s) already staged`) rather than mixing into it."]
                :anti-patterns
                [{:rule "Don't read `~ N update transforms` as an undeployed backlog."
                  :why "Every python transform of a project is reported as `update` on every run, forever, even when prod is byte-identical to the checkout (measured: werft 8/8, ersatzteile 11/11) — a cosmetic wire-args asymmetry in plan-diff. Applications in the same file correctly say `unchanged`, so it is transform-specific. Verify with `transform edit <name> --print`, which returns the LIVE code, before believing the diff: reading the noise as real drift has already produced a confident, wrong 'this fix is waiting to go live' about code that had been live for hours."}]
                :examples ["diff-schema projects/foo/schema.ent"
                           "diff ontology.ent apps/ersatzteile.enta"]
                :see-also [:install :check]}
  :check       {:theme :inspect
                :purpose "Pre-save safety report: schema validity + health + staged blast-radius, plus doc-sourced lint findings."
                :when "Before `commit`/`save`."
                :see-also [:lint :review :commit]}
  :lint        {:theme :inspect
                :purpose "Run doc-sourced anti-pattern checks over the staged schema delta."
                :when "After staging schema changes, before committing — catches modeling mistakes (non-deterministic keys, cryptic names, missing titles) with a doc citation."
                :patterns
                ["Runs over the STAGED delta only — it flags authoring mistakes, never touches committed data."]
                :examples ["lint" "lint --json"]
                :see-also [:check :primary-key :ontology-lint]}
  :ontology-lint {:theme :inspect
                  :purpose "Lint the LIVE ontology client-side — the same doc-sourced rules as `lint`, but over the fetched current-schema instead of the staged delta."
                  :when "To audit what's already committed live (e.g. find links that violate the FK-backing invariant BEFORE a deploy makes the server's commit gate fail-close). A trailing <rule-id> narrows to one rule."
                  :patterns
                  ["Reads the live schema, not the staged delta — the companion to `lint` for checking an as-yet-undeployed rule against prod."]
                  :examples ["ontology lint" "ontology lint link-fk-backing" "ontology lint --json"]
                  :see-also [:lint :check :describe]}
  :platform    {:theme :operate
                :purpose "The instance's own name and logo. Shows both; --title renames the platform everywhere its name is printed, --logo/--file sets one of the four sizes, --clear drops one."
                :when "Setting up a fresh instance, or when a customer's platform should carry their name instead of the shipped one. The title is what every UI string's {platform} token resolves to."
                :examples ["platform" "platform --title \"Sutra-OS\""
                           "platform --logo favicon --file logo.png" "platform --clear small"]
                :see-also [:access :overview]}
  :overview    {:theme :orient
                :purpose "One-call orientation: branch + total object/link counts + per-object-type instance breakdown."
                :when "First thing to run against an unfamiliar/prod instance — 'what's in here and how much', without an N-query loop over every type."
                :examples ["overview" "overview --json"]
                :see-also [:context :describe :query]}
  :apps        {:theme :orient
                :purpose "List the App Studio apps on the branch — what an end user actually gets."
                :when "To judge whether the use-case's end-user surface exists, not just the data model."
                :examples ["apps" "apps --json"]
                :see-also [:app :app-data :projects :overview]}
  :app         {:theme :orient
                :purpose "ONE app's :layout whitelists — the object-types it binds and which action/upload/export a consumer may submit (what an end user can DO)."
                :when "Before touching source: to see an app's consumer trust boundary. Prefer this over reading the app's .ent or hand-rolling an HTTP call."
                :examples ["app arbeitspaket-korrektur" "app konten-chart --json"]
                :see-also [:apps :app-data]}
  :app-data    {:theme :orient
                :purpose "The objects an app SERVES its consumers (grant-scoped, via my-application) — the data the end user's app actually shows. Seeds the register."
                :when "To see an app end-to-end without opening a browser or scripting the HTTP endpoint. --type focuses one bound type, --limit caps rows, --scenario <seg> reads the data on a scenario fork instead of the base."
                :examples ["app-data arbeitspaket-korrektur"
                           "app-data arbeitspaket-korrektur --type arbeitsauftrag --limit 20"
                           "app-data wochenvorschau --scenario 3f2a.QW5uYQ"]
                :see-also [:app :apps :query :scenarios]}
  :templates   {:theme :orient
                :purpose "The document TEMPLATES installed on the branch — the blueprint half of Documents, and an ontology resource like any other: declared in a doc-templates/<name>.entt, shipped through the code-repository projection (`projection push`), versioned."
                :when "Before generating anything, to see which reports exist and which are published. A template is the only reviewable half of a document — the document itself is user content."
                :examples ["templates" "templates --json"]
                :see-also [:template :render-template :documents]}
  :template    {:theme :orient
                :purpose "ONE template in full: its typed parameters (string/number/date/object/object-set), its page box, its generation limits and every published version."
                :when "Before calling render-template, to learn what the body expects. --version reads a published release rather than the tip, which is what a document already generated from it was rendered against."
                :examples ["template monatsbericht" "template monatsbericht --version 1.2.0"]
                :see-also [:templates :render-template]}
  :render-template {:theme :orient
                    :purpose "Render a template read-only and print (or write) the result — the document counterpart of `transform preview`. Stages nothing, saves nothing."
                    :when "To find out WHY a report is empty or wrong before generating it: an undeclared name in the body fails here, loudly, instead of printing a blank cell. --value k=v binds one parameter (an object-set takes `id1,id2`, `[\"id1\" \"id2\"]` or a read spec `{:where {…}}`); --preview uses each parameter's declared preview value; --file doc-templates/x.entt renders the CHECKOUT's draft against live data without installing it — no version bump, no push; --pdf paginates through WeasyPrint; --out writes the bytes to a file. A body error names the template and the line."
                    :examples ["render-template monatsbericht --value monat=2026-07"
                               "render-template monatsbericht --preview"
                               "render-template --file doc-templates/monatsbericht.entt --preview"
                               "render-template monatsbericht --value posten=4711,4712"
                               "render-template monatsbericht --value monat=2026-07 --pdf --out bericht.pdf"]
                    :see-also [:template :templates :documents]}
  :documents   {:theme :orient
                :purpose "The DOCUMENTS on this branch — generated or hand-written content, with the template and version each came from."
                :when "To see what has been produced from a template, or to find the id of a document to export. Documents are per-branch rows, not schema: nothing here goes through a proposal."
                :examples ["documents" "documents --template monatsbericht"]
                :see-also [:templates :render-template]}
  :document    {:theme :orient
                :purpose "ONE document: its template and version, the parameters it was generated with, its object links, then the body."
                :when "To read what a generated report actually says, or to pull the body into a file (--out FILE) to edit it and bring it back with `document update --file`."
                :examples ["document 3f2a…" "document 3f2a… --out bericht.md"]
                :see-also [:documents :document-update :document-versions]}
  :document-create {:theme :data
                    :purpose "Create a hand-written document from a local file. The format follows the extension (.md → markdown, .html → html, else text) unless --format says otherwise. --project files it in a project (a use case's documentation lives in its project)."
                    :when "To put a note or a report written outside the platform into Documents on this branch. Documents are user content — nothing goes through a proposal."
                    :examples ["document create --file notiz.md"
                               "document create --file use-case.md --name \"Use Case: Rechnungseingang\" --project einkauf"
                               "document create --file brief.html --name \"Brief an Kunde\""]
                    :see-also [:document-update :documents]}
  :document-update {:theme :data
                    :purpose "Replace a document's body from a file, and/or cut a NAMED version (--label) or an ENDORSED one (--endorse). Without --file it cuts a version of the current body."
                    :when "After editing a document outside the platform, or to mark a state worth returning to: an unnamed save becomes a version only as the five-minute autosave, a labelled one always does."
                    :examples ["document update 3f2a… --file bericht.md"
                               "document update 3f2a… --label \"an GF\" --endorse"]
                    :see-also [:document-versions :document-restore]}
  :use-case-plan {:theme :data
                  :purpose "The use-case assistant: read a use case's draft model — an EDN document in its project (types with class, links with cardinality, statecharts with actions, sources, write-backs) — and hold it against the live ontology of the branch. Lists every object type, link type, action, group, source and write-back as create / change / retire / keep / check, marks what `use-case apply` may stage by itself, and names the open points of the guide's checklist plus class rules read off the lineage. --preview also plans the staging in a rolled-back transaction."
                  :when "While drafting a use case, before anything is built — and again after each build step, to see what is still missing."
                  :examples ["use-case plan 4b1c…"
                             "use-case plan 4b1c… --preview"
                             "--branch zugaenge use-case plan 4b1c…"]
                  :see-also [:use-case-apply :use-case-diagram :document-create]}
  :use-case-apply {:theme :data
                   :purpose "Stage what the draft's plan may do by itself — new Use-Case object types, link types between types that exist, lifecycle actions (generated from the statecharts unless the draft gives them), the object-type group — on a BRANCH, never on main. Kern and derived types, changes to installed types and sources stay proposals (a partial install would clear an installed type's other fields; sources are instance-wide). --retire also deletes what the draft draws as :retired. Commit and propose as usual afterwards."
                   :when "After `use-case plan` reads right; then `commit`, `propose --target main`."
                   :examples ["branch zugaenge" "--branch zugaenge use-case apply 4b1c…"
                              "--branch zugaenge use-case apply 4b1c… --retire"]
                   :see-also [:use-case-plan :commit :propose]}
  :use-case-diagram {:theme :data
                     :purpose "Draw the draft's object model and every statechart as SVG, on the server with graphviz, in the colours of the guide (Kern, Abgeleitet, Use Case; what the ontology lacks dashed). The same pictures the Notebook widget `use-case-draft` shows."
                     :when "To look at a draft outside Notebook, or to attach the sketches somewhere else."
                     :examples ["use-case diagram 4b1c… --out /tmp/zugaenge"]
                     :see-also [:use-case-plan]}
  :doc-intel-run {:theme :data
                  :purpose "Run one extraction strategy (a JSON file: strategy, mode, languages, for vlm model, preprocess, prompt, for entities model, entities, prompt) on one page of one media item, with time, tokens and cost; --judge M adds the model's 1-5 scores. Nothing is written."
                  :when "Comparing strategies before one is deployed, as in the Document Intelligence app."
