                  :see-also [:doc-intel-deploy]}
  :doc-intel-deploy {:theme :data
                     :purpose "Create a transform repository: commit a compared strategy as a transform template (transforms/<name>.py, its prompts, a README section) onto the session's branch of a code repository. Then clone, specify the output dataset in the decorator, commit, git push."
                     :when "A strategy has proven itself on real documents and should run over the whole media set."
                     :patterns ["The decorator is the declaration: a pushed transforms/*.py with @transform needs no .ent node, and its output dataset is declared with it."]
                     :examples ["document-intelligence deploy beleg-seiten --source raw_attachments --strategy-file s.json --repository beschaffung"]
                     :see-also [:doc-intel-run :new-transform]}
  :document-generate {:theme :data
