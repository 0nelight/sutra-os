{:paths ["src"]
 :deps  {sutra/core {:local/root "../../libs/core"}}
 :tasks
 {status {:doc  "the author's screen for this checkout"
          :requires ([sutra.change.main])
          :task (apply sutra.change.main/-main *command-line-args*)}
  test   {:doc "run the client's tests"
          :extra-paths ["test"]
          :requires ([clojure.test :as t] [change.status-test])
          :task (let [r (t/run-tests 'change.status-test)]
                  (System/exit (if (zero? (+ (:fail r) (:error r))) 0 1)))}}}
