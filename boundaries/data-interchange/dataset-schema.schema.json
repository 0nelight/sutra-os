        },
        "mode": {
          "description": "append (default) or snapshot",
          "enum": [
            "append",
            "snapshot"
          ],
          "type": "string"
        },
        "rows": {
          "items": {
            "additionalProperties": {},
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "rows"
      ],
      "title": "rows write",
      "type": "object"
    },
