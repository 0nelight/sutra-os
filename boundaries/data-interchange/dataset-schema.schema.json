      "description": "The columns of a dataset, in order, and the columns that key a row.",
      "properties": {
        "columns": {
          "items": {
            "description": "One column: its name and value type. A keyword travels as a string; a parameterised type as an array: [\"decimal\", precision, scale], [\"array\", type], [\"struct\", {name: type}].",
            "properties": {
              "attribute-name": {
                "type": "string"
              },
