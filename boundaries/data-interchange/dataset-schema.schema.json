              },
              "opts": {
                "oneOf": [
                  {
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "attribute-name",
              "attribute-type"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "dataset": {
          "description": "The dataset's name or rid."
        },
        "kind": {
          "description": "transform-output, standalone, materialization, …",
          "type": "string"
        },
        "primary-key": {
          "oneOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "columns"
      ],
      "title": "dataset schema",
      "type": "object"
    },
    "rows-write": {
