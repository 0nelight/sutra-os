# An action is a typed method: its signature comes from the model, a missing
# argument is flagged before anything runs. Run through media/sdk/record.
Source editor.tape

Sleep 700ms
Type "o" Enter
Type "lot."
Sleep 3s
Type "sell_hay("
Sleep 2.5s
Type 'bales=20, buyer="Neighbour")'
Escape
Sleep 3.5s
Type "i"
Type ', sale_nr="S-2026-010"'
Escape
Sleep 3s
