# A filter compares like with like, and an optional link is optional:
# both are caught before anything runs. Run through media/sdk/record.
Source editor.tape

Sleep 700ms
Type "o" Enter
Type 'running_low = Lot.where(Lot.in_barn < "forty")'
Escape
Sleep 4s
Type '0f"ct)50'
Escape
Sleep 2s
Type "o" Enter
Type "lot.field.margin"
Escape
Sleep 4s
