  :table-allow
  []
  :cross-module-tx
  [{:modules [actions lease world]
    :why     "an action's edits, its request record and its outbox land in one fenced commit"
    :where   [sutra.actions.action sutra.actions.apply sutra.actions.dispatch
              sutra.actions.staged]}
   {:modules [actions world]
    :why     "an action's edits as the element changes of its step: no [:schema] fence, a stale change is refused itself"
    :where   [sutra.actions.action sutra.actions.staged]}
   {:modules [actions builds lease world]
    :why     "landing a staged batch commits its edits and the build ledger of that run"
    :where   [sutra.actions.landing sutra.builds.run]}
   {:modules [builds lease world]
    :why     "landing a staging branch of schema changes alone (no staged action row to retire)
              commits its world and the build ledger of that run"
    :where   [sutra.actions.landing sutra.builds.run]}
   {:modules [lease schedules]
    :why     "an action's schedule-run effect records the run setup of the build it starts
              under the fence of that action"
    :where   [sutra.schedules.dispatch sutra.actions.effects]}
   {:modules [lease media]
    :why     "a media-set sync records the items it lands under the fence of its build run"
    :where   [sutra.media.sets sutra.builds.run.media-sync]}
   {:modules [automation lease world]
    :why     "a rule's action and the automation's execution record are one commit"
    :where   [sutra.automation.rules sutra.actions.dispatch]}
   {:modules [scenarios world]
    :why     "a scenario's state moves with the edits applied to it"
    :where   [sutra.scenarios.apply]}
   {:modules [lease scenarios]
    :why     "a scenario's state is written under the fence of the action that changes it"
    :where   [sutra.scenarios.state sutra.actions.dispatch]}
   {:modules [lease sources]
    :why     "a writeback claim is taken in the fenced commit of the action that writes back"
    :where   [sutra.actions.effects sutra.actions.execution]}
   {:modules [governance lease]
    :why     "a merge records its attempt under the fence of the landing it belongs to"
    :where   [sutra.governance.merge sutra.actions.landing]}
   {:modules [governance lease world]
    :why     "landing a proposal merges the world and records the verdict in one commit"
    :where   [sutra.branching.landing sutra.authoring.install.world]}
   {:modules [authoring world]
    :why     "an install commits the schema and its placements and releases together"
    :where   [sutra.authoring.install.world]}
   {:modules [authoring lease world]
    :why     "a schema change saved on a branch directly (a mutation, a rename) commits its
              world and the release records it cuts under the fence of what it read"
    :where   [sutra.authoring.install.world sutra.authoring.mutation]}
   {:modules [canvas world]
    :why     "seen from the store itself, no platform caller on the stack: a canvas record
              written in a world commit (a sweep or a branch commit)"
    :where   []}
   {:modules [canvas store]
    :why     "seen from the store itself: a canvas record committed with an event cursor
              (a consumer that sweeps dropped graphs)"
    :where   []}
   {:modules [builds lease]
    :why     "a build run writes its rows under the fence of its run lease"
    :where   [sutra.builds.run.rows sutra.builds.run sutra.builds.import sutra.builds.run.lock]}
   {:modules [health lease]
    :why     "a build records its expectations' results (:health/record-expectation) under the
              fence of its run"
    :where   [sutra.builds.plan.expectations sutra.builds.import.phases]}
   {:modules [lease projects]
    :why     "a build that materializes nodes places them in the project map under its fence"
    :where   [sutra.projects.kompass sutra.builds.import.materialize]}
   {:modules [canvas lease projects]
    :why     "an action that drops objects sweeps their canvas graphs and project placements
              in its own fenced commit (seen in the scenario tier)"
    :where   [sutra.actions.action sutra.actions.apply]}]}

 :layers
 [
  {:why        "A role answers from its arguments: a plugin contributes an entry to a table and is asked. It never reaches into the store, a module of the host or the server — those stay the host's, which is what makes a contributed entry safe to accept."
   :from-roots ["plugins"]
   :to         [sutra.catalog.* sutra.store.* sutra.http.* sutra.serve.*
                sutra.access.* sutra.llm.* sutra.media.* sutra.repos.* sutra.projects.*
                sutra.sources.* sutra.compute.* sutra.objects.* sutra.governance.*
                sutra.actions.* sutra.authoring.* sutra.builds.* sutra.scenarios.*
                sutra.schedules.* sutra.notifications.* sutra.lineage.* sutra.health.*
                sutra.canvas.* sutra.agents.* sutra.apps.* sutra.automation.* sutra.evals.*
                sutra.documents.* sutra.branching.* sutra.feedback.*]}

  {:why
   "The language knows no runtime: it is read by the frontend, the CLI and the server alike."
   :from-roots ["libs/kernel/src" "libs/dialect/src" "libs/core/src"]
   :to         [sutra.catalog.* sutra.store.* sutra.http.* sutra.serve.*
                sutra.access.* sutra.llm.* sutra.media.* sutra.repos.* sutra.projects.*
                sutra.sources.* sutra.compute.* sutra.objects.* sutra.governance.*
                sutra.actions.* sutra.authoring.* sutra.builds.* sutra.scenarios.*
                sutra.schedules.* sutra.notifications.* sutra.lineage.* sutra.health.*
                sutra.canvas.* sutra.agents.* sutra.apps.* sutra.automation.* sutra.evals.*
                sutra.documents.* sutra.branching.* sutra.feedback.*]}

  {:why        "The kern knows the kernel's registers and its refusal catalog, nothing else of the platform: the old implementation is its oracle, never its dependency."
   :from-roots ["libs/world/src"]
   :to         [sutra.*]
   :except-to  [sutra.world.* sutra.types.entities sutra.types.kinds sutra.types.refs
                sutra.types.table sutra.types.nested sutra.ref.err]}

  {:why   "Inside the kern a namespace requires only those of earlier groups: the store cycle of KW46 (store.protection → store.control → store.records → store.world) grew between namespaces of one module, where no rule looked."
   :order [[sutra.world.delta sutra.world.index sutra.world.schema]
           [sutra.world.db]
           [sutra.world.view sutra.world.instance]
           [sutra.world.gate.base sutra.world.policy]
           [sutra.world.gate.space sutra.world.gate.media sutra.world.gate.stream
            sutra.world.gate.marking sutra.world.gate.near]
           [sutra.world.gate.lint]
           [sutra.world.gate]
           [sutra.world.install]]}

  {:why        "The store layer of the reimplementation reads the store's log and steps the kern's db; it knows nothing else of the platform."
   :from-roots ["libs/commits/src"]
   :to         [sutra.*]
   :except-to  [sutra.commits.* sutra.world.* sutra.store.core.* sutra.store.memo]}

  {:why        "What the store layer stands on never reaches up into it: the store is its oracle, the kern its model."
   :from-roots ["libs/kernel/src" "libs/world/src" "libs/dialect/src" "libs/core/src"
                "libs/store/src"]
   :to         [sutra.commits.*]}

  {:why   "Inside the store layer a namespace requires only those of earlier groups."
   :order [[sutra.commits.log]
           [sutra.commits.loader]
           [sutra.commits.schatten sutra.commits.branches]]}

  {:why        "The service layer of the reimplementation stands on the kern and the dialect's tree; it knows nothing else of the platform, and the policy it answers stays sutra.types.authority, its oracle."
   :from-roots ["libs/service/src"]
   :to         [sutra.*]
   :except-to  [sutra.service.* sutra.world.* sutra.types.tree sutra.types.rid
                sutra.types.entities]}

  {:why        "What the service layer stands on never reaches up into it: the store does not know who may do what, so no cycle runs through authority (KW46: authority ↔ world)."
   :from-roots ["libs/kernel/src" "libs/world/src" "libs/commits/src" "libs/dialect/src"
                "libs/core/src"
                "libs/store/src"]
   :to         [sutra.service.*]}

  {:why   "Inside the service layer a namespace requires only those of earlier groups."
   :order [[sutra.service.merge sutra.service.rights] [sutra.service.access]]}

  {:why        "A handler is the edge of its module: only the composition root and other handlers reach it, and what it calls never calls back into it."
   :from-roots ["src"]
   :except     [sutra.*.http sutra.*.http.* sutra.serve.*]
   :to         [sutra.*.http sutra.*.http.*]}

  {:why   "Background work runs through the store and its own planning, not through the commands of a request."
   :from  [sutra.builds.* sutra.schedules.*]
   :to    [sutra.actions.* sutra.authoring.*]}

  {:why       "A build reaches foreign sources through the port :foreign/connect (sutra.store.access.scope) and what sources and compute provide (:foreign/datasources, :compute/runner), and reads a source by the contract sutra.sources.api — never their implementation."
   :from      [sutra.builds.*]
   :except    [sutra.*.http sutra.*.http.*]
   :to        [sutra.sources.* sutra.compute.*]
   :except-to [sutra.sources.api]}]}
